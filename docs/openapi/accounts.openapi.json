      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1,
            "description": "JWT real solo en ejecución; los ejemplos usan un marcador no válido."
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14400,
            "description": "Duración restante del JWT en segundos; el servidor actual emite 14400 (4 horas)."
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 160
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMIN",
              "CAPTADOR",
              "SUPERVISOR"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "CAPTADOR",
                "SUPERVISOR"
              ]
            },
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true
          },
          "siteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "uniqueItems": true,
            "maxItems": 8,
            "description": "IDs canónicos de las ocho sedes del catálogo vigente. Deben existir y estar habilitados; no se acepta una sede por su forma solamente."
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "userId",
          "username",
          "email",
          "displayName",
          "rol",
          "roles",
          "siteIds"
        ],
        "description": "rol y roles[0] coinciden; estado ACTIVE requerido en BD. Conserva nombres del DTO existente.",
        "examples": [
          {
            "accessToken": "EJEMPLO-NO-VALIDO",
            "tokenType": "Bearer",
            "expiresIn": 14400,
            "userId": "11111111-1111-4111-8111-111111111111",
            "username": "persona.demo@example.invalid",
            "email": "persona.demo@example.invalid",
