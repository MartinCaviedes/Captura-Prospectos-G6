  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 160
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "writeOnly": true,
            "description": "Validar también máximo 72 bytes UTF-8 para BCrypt; no truncar."
          }
        },
        "required": [
          "displayName",
          "email",
          "password"
        ],
        "examples": [
          {
            "displayName": "Persona de prueba",
            "email": "persona.demo@example.invalid",
            "password": "ClaveDemo-2026"
          }
        ]
      },
      "RegistrationReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "PENDING",
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "userId",
          "status",
          "message"
        ],
        "examples": [
          {
            "userId": "11111111-1111-4111-8111-111111111111",
            "status": "PENDING",
            "message": "Solicitud recibida."
          }
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true,
            "description": "Admite credenciales anteriores; aplicar límite UTF-8 del verificador BCrypt."
          }
        },
        "required": [
          "username",
          "password"
        ],
        "examples": [
          {
            "username": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@example.test",
            "password": "ClaveDemo-2026"
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_CREDENTIALS",
              "TOKEN_EXPIRED",
              "INVALID_TOKEN",
              "ACCOUNT_PENDING",
              "ACCOUNT_DISABLED",
              "ACCESS_DENIED",
              "USER_NOT_FOUND",
              "ACCOUNT_EXISTS",
              "VERSION_CONFLICT",
              "ADMIN_PROTECTED",
              "RATE_LIMITED",
              "SERVICE_UNAVAILABLE",
              "UPSTREAM_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message"
        ],
        "examples": [
          {
            "code": "VERSION_CONFLICT",
            "message": "Actualiza los datos antes de guardar."
          }
        ]
      },
      "UserSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 160
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "DISABLED"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ADMIN",
              "CAPTADOR",
              "SUPERVISOR",
              null
            ]
          },
          "siteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "uniqueItems": true,
            "maxItems": 8,
            "description": "IDs canónicos de las ocho sedes del catálogo vigente. Deben existir y estar habilitados; no se acepta una sede por su forma solamente."
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "displayName",
          "status",
          "role",
          "siteIds",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PENDING"
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "type": "null"
                },
                "siteIds": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ACTIVE"
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ACTIVE"
                },
                "role": {
                  "enum": [
                    "CAPTADOR",
                    "SUPERVISOR"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "siteIds": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "siteIds": {
                  "maxItems": 0
                }
              }
            }
          }
        ],
        "examples": [
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "persona.demo@example.invalid",
            "email": "persona.demo@example.invalid",
            "displayName": "Persona de prueba",
            "status": "PENDING",
            "role": null,
            "siteIds": [],
            "version": 0,
            "createdAt": "2026-11-21T12:00:00Z",
            "updatedAt": "2026-11-21T12:00:00Z"
          },
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "persona.demo@example.invalid",
            "email": "persona.demo@example.invalid",
            "displayName": "Persona de prueba",
            "status": "ACTIVE",
            "role": "CAPTADOR",
            "siteIds": [
              "site-1"
            ],
            "version": 1,
            "createdAt": "2026-11-21T12:00:00Z",
            "updatedAt": "2026-11-21T12:05:00Z"
          },
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "persona.demo@example.invalid",
            "email": "persona.demo@example.invalid",
            "displayName": "Persona de prueba",
            "status": "ACTIVE",
            "role": "ADMIN",
            "siteIds": [],
            "version": 1,
            "createdAt": "2026-11-21T12:00:00Z",
            "updatedAt": "2026-11-21T12:05:00Z"
          },
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "persona.demo@example.invalid",
            "email": "persona.demo@example.invalid",
            "displayName": "Persona de prueba",
            "status": "DISABLED",
            "role": null,
            "siteIds": [],
            "version": 1,
            "createdAt": "2026-11-21T12:00:00Z",
            "updatedAt": "2026-11-21T12:00:00Z"
          }
        ]
      },
      "AccessRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "CAPTADOR",
              "SUPERVISOR",
              null
            ]
          },
          "siteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "uniqueItems": true,
            "maxItems": 8,
            "description": "IDs canónicos de las ocho sedes del catálogo vigente. Deben existir y estar habilitados; no se acepta una sede por su forma solamente."
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "role",
          "siteIds",
          "expectedVersion"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ACTIVE"
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "type": "string"
                },
                "siteIds": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": "DISABLED"
                },
                "siteIds": {
                  "maxItems": 0
                }
              }
            }
          }
        ],
        "examples": [
          {
            "status": "ACTIVE",
            "role": "CAPTADOR",
            "siteIds": [
              "site-1"
            ],
            "expectedVersion": 0
          },
          {
            "status": "DISABLED",
            "role": null,
            "siteIds": [],
            "expectedVersion": 0
          }
        ]
      },
      "AdminCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^@]+$",
            "description": "Nombre administrativo sin @ para no solapar el espacio de correos de autorregistro. Se normaliza en minúsculas y se recortan extremos."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 160
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "writeOnly": true,
            "description": "Validar también máximo 72 bytes UTF-8 para BCrypt; no truncar."
          },
          "rol": {
            "type": "string",
            "enum": [
              "CAPTADOR",
              "SUPERVISOR"
            ]
          },
          "sedesAsignadas": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Compatibilidad con el DTO actual: IDs separados por coma, todos válidos. Sin default site-1. Alta administrativa ACTIVE. No admite ADMIN."
          }
        },
        "required": [
          "username",
          "email",
          "displayName",
          "password",
          "rol",
          "sedesAsignadas"
        ],
        "examples": [
          {
            "username": "captador.demo",
            "email": "captador.demo@example.invalid",
            "displayName": "Captador de prueba",
            "password": "ClaveDemo-2026",
            "rol": "CAPTADOR",
            "sedesAsignadas": "site-1"
          }
        ]
      },
      "LegacyStateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activo": {
            "type": "boolean"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "activo",
          "expectedVersion"
        ],
        "description": "expectedVersion se añade obligatoriamente; adaptar clientes antiguos. No aprueba PENDING ni modifica permisos.",
        "examples": [
          {
            "activo": false,
            "expectedVersion": 1
          }
        ]
      },
      "LogoutReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
