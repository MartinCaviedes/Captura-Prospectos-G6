{
  "openapi": "3.1.0",
  "info": {
    "title": "Captura de Prospectos G6 · Cuentas E2",
    "version": "0.3.0-e2",
    "description": "Identidad y administración implementadas e integradas con Android. JWT online de hasta 14400 segundos (4 horas), sin refresh ni revocación inmediata; los permisos se comprueban al administrar cuentas. La sesión offline de Android es independiente del JWT. Ejemplos ficticios, sin token válido."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Mismo gateway; para importar en otra herramienta configurar su URL local o HTTPS."
    }
  ],
  "tags": [
    {
      "name": "Identidad"
    },
    {
      "name": "Administración"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "summary": "Solicitar cuenta pendiente",
        "description": "No crea sesión ni concede rol/sedes. Rechazar campos extra. Normalizar email; username=email. Rate-limit de registro y unicidad insensible a mayúsculas en BD.",
        "tags": [
          "Identidad"
        ],
        "responses": {
          "201": {
            "description": "Solicitar cuenta pendiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationReceipt"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE desde usuarios o UPSTREAM_UNAVAILABLE desde gateway; conservar datos y permitir reintento.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "ACCOUNT_EXISTS; registro simultáneo no debe crear dos cuentas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos hasta poder reintentar.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "504": {
            "description": "Timeout al servicio aguas arriba; formato no normalizado con Error."
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    },
