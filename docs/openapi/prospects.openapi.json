    "/prospects/sync/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID local estable de la captura; no es remoteId.",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "operationId": "syncCapture",
        "summary": "Sincronizar revisión de captura",
        "description": "CAPTADOR propietario o SUPERVISOR de sede; ADMIN no tiene esta operación. Primera escritura requiere ownerId del actor, expectedRevision=0 y estado distinto de CANCELLED. Reenvío idéntico conserva ACK; misma revisión con otro cuerpo produce SYNC_REPLAY_CONFLICT. DeviceId e identidad de inscripción son inmutables. Revisiones siguientes requieren expectedRevision vigente y ficha remota sin cambios ajenos. state READY/NEEDS_CONTEXT no es el status ACTIVE de Prospect. Se almacena snapshotJson pero no hay descarga/reconciliación del formulario completo en esta API.",
        "tags": [
          "Sincronización"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-roles": [
          "CAPTADOR",
          "SUPERVISOR"
        ],
        "responses": {
          "200": {
            "description": "Sincronizar revisión de captura",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureSyncAck"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_RUT o INVALID_PAGE; en sync también INVALID_SNAPSHOT y REASON_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente, vencido o inválido. El gateway puede responder sin cuerpo; el microservicio incluye UNAUTHORIZED."
          },
          "403": {
            "description": "FORBIDDEN: rol, propietario o sede no autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible. El gateway devuelve code=UPSTREAM_UNAVAILABLE si se rechaza la conexión."
          },
          "504": {
            "description": "El gateway agotó el tiempo de espera del servicio; el formato no está normalizado con ProspectError."
          },
          "409": {
            "description": "SYNC_BASE_MISSING, SYNC_REMOTE_MISSING, SYNC_IDENTITY_CONFLICT, SYNC_REPLAY_CONFLICT, SYNC_VERSION_CONFLICT, DUPLICATE_EVENT_REGISTRATION o CONCURRENT_UPDATE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureSyncRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateProspectRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rut": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "description": "Admite puntos; se normaliza y comprueba dígito verificador módulo 11."
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "siteId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "givenNames": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "familyNames": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "consentAccepted": {
            "type": "boolean",
            "const": true
          },
          "consentVersion": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "required": [
          "rut",
          "eventId",
          "siteId",
          "givenNames",
          "familyNames",
          "email",
          "phone",
          "consentAccepted",
          "consentVersion"
        ],
        "examples": [
          {
            "rut": "12.345.678-5",
            "eventId": "22222222-2222-4222-8222-222222222222",
            "siteId": "site-1",
            "givenNames": "Persona",
            "familyNames": "Ficticia",
            "email": "persona@example.invalid",
            "phone": "+56912345678",
            "consentAccepted": true,
            "consentVersion": "F2027_1"
          }
        ]
      },
      "UpdateProspectRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "givenNames": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "familyNames": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{8,15}$"
          }
        },
        "required": [
          "givenNames",
          "familyNames",
          "email",
          "phone"
        ],
        "examples": [
          {
            "givenNames": "Persona",
            "familyNames": "Ficticia",
            "email": "persona@example.invalid",
            "phone": "+56912345678"
          }
        ]
      },
      "CancelProspectRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "required": [
          "reason"
        ],
        "examples": [
          {
            "reason": "Corrección supervisada ficticia"
          }
        ]
      },
      "Prospect": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rut": {
            "type": "string",
            "maxLength": 12
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "siteId": {
            "type": "string",
            "maxLength": 120
          },
          "captorId": {
            "type": "string",
            "format": "uuid"
          },
          "givenNames": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "familyNames": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "consentVersion": {
            "type": "string",
            "maxLength": 80
          },
          "consentRecordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CANCELLED"
            ]
          },
          "cancelledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancelledBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "cancellationReason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "version",
          "rut",
          "eventId",
          "siteId",
          "captorId",
          "givenNames",
          "familyNames",
          "email",
          "phone",
          "consentVersion",
          "consentRecordedAt",
          "createdAt",
          "updatedAt",
          "status",
          "cancelledAt",
          "cancelledBy",
          "cancellationReason"
        ]
      },
      "ProspectPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Prospect"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
        ]
      },
      "ProspectError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "fieldErrors",
          "correlationId"
        ],
        "examples": [
          {
            "code": "SYNC_VERSION_CONFLICT",
            "message": "El estado actual no permite la operación",
            "fieldErrors": {},
            "correlationId": "33333333-3333-4333-8333-333333333333"
          }
        ]
      },
      "CaptureSyncRequest": {
        "type": "object",
        "additionalProperties": false,
