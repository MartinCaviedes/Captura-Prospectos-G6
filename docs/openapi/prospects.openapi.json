      }
    },
    "/prospects/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID del prospecto remoto.",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelProspect",
        "summary": "Anular inscripción",
        "description": "Solo SUPERVISOR de la sede o ADMIN. Anulación lógica con motivo/actor/fecha; no borra la ficha. CAPTADOR no puede usar esta ruta; la anulación local propia puede enviarse por sync.",
        "tags": [
          "Prospectos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-roles": [
          "SUPERVISOR",
          "ADMIN"
        ],
        "responses": {
          "200": {
            "description": "Anular inscripción",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prospect"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_RUT o INVALID_PAGE; en sync también INVALID_SNAPSHOT y REASON_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente, vencido o inválido. El gateway puede responder sin cuerpo; el microservicio incluye UNAUTHORIZED."
          },
          "403": {
            "description": "FORBIDDEN: rol, propietario o sede no autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible. El gateway devuelve code=UPSTREAM_UNAVAILABLE si se rechaza la conexión."
          },
          "504": {
            "description": "El gateway agotó el tiempo de espera del servicio; el formato no está normalizado con ProspectError."
          },
          "404": {
            "description": "NOT_FOUND: prospecto no encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_EVENT_REGISTRATION, PROSPECT_CANCELLED o CONCURRENT_UPDATE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
