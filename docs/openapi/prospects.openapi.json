{
  "openapi": "3.1.0",
  "info": {
    "title": "Captura de Prospectos G6 · Prospectos y sincronización",
    "version": "0.3.0-e2",
    "description": "Contrato de rutas implementadas. Ejemplos ficticios; no documenta catálogos/eventos remotos futuros ni el proveedor público BigDataCloud como rutas propias."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Mismo gateway que sirve la documentación."
    }
  ],
  "tags": [
    {
      "name": "Prospectos"
    },
    {
      "name": "Sincronización"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/prospects": {
      "get": {
        "operationId": "listProspects",
        "summary": "Listar prospectos visibles",
        "description": "CAPTADOR: propios; SUPERVISOR: sedes del JWT; ADMIN: todos. Incluye anulados, orden createdAt/id; paginación por página, no cursor.",
        "tags": [
          "Prospectos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-roles": [
          "CAPTADOR",
          "SUPERVISOR",
          "ADMIN"
        ],
        "responses": {
          "200": {
            "description": "Listar prospectos visibles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectPage"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_RUT o INVALID_PAGE; en sync también INVALID_SNAPSHOT y REASON_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente, vencido o inválido. El gateway puede responder sin cuerpo; el microservicio incluye UNAUTHORIZED."
          },
          "403": {
            "description": "FORBIDDEN: rol, propietario o sede no autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible. El gateway devuelve code=UPSTREAM_UNAVAILABLE si se rechaza la conexión."
          },
          "504": {
            "description": "El gateway agotó el tiempo de espera del servicio; el formato no está normalizado con ProspectError."
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      },
      "post": {
        "operationId": "createProspect",
        "summary": "Crear inscripción mínima",
        "description": "Solo CAPTADOR de la sede. captorId deriva del JWT. Una inscripción activa por RUT normalizado y evento. El servicio no verifica existencia/asignación remota del evento.",
        "tags": [
          "Prospectos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-roles": [
          "CAPTADOR"
        ],
        "responses": {
          "201": {
            "description": "Crear inscripción mínima",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prospect"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_RUT o INVALID_PAGE; en sync también INVALID_SNAPSHOT y REASON_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente, vencido o inválido. El gateway puede responder sin cuerpo; el microservicio incluye UNAUTHORIZED."
          },
          "403": {
            "description": "FORBIDDEN: rol, propietario o sede no autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible. El gateway devuelve code=UPSTREAM_UNAVAILABLE si se rechaza la conexión."
          },
          "504": {
            "description": "El gateway agotó el tiempo de espera del servicio; el formato no está normalizado con ProspectError."
          },
          "409": {
            "description": "DUPLICATE_EVENT_REGISTRATION, PROSPECT_CANCELLED o CONCURRENT_UPDATE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProspectRequest"
              }
            }
          }
        }
      }
    },
