      "put": {
        "operationId": "updateProspect",
        "summary": "Actualizar contacto",
        "description": "Reemplaza los cuatro campos de contacto de una ficha activa. CAPTADOR propietario, SUPERVISOR de sede o ADMIN. No admite expectedVersion ni cambia RUT/evento/sede/propietario/consentimiento. Puede provocar conflicto con la siguiente sincronización.",
        "tags": [
          "Prospectos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-roles": [
          "CAPTADOR",
          "SUPERVISOR",
          "ADMIN"
        ],
        "responses": {
          "200": {
            "description": "Actualizar contacto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prospect"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_RUT o INVALID_PAGE; en sync también INVALID_SNAPSHOT y REASON_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProspectError"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente, vencido o inválido. El gateway puede responder sin cuerpo; el microservicio incluye UNAUTHORIZED."
          },
          "403": {
            "description": "FORBIDDEN: rol, propietario o sede no autorizados.",
            "content": {
              "application/json": {
