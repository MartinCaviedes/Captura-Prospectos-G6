<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>io.github.grupo6</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <!-- Parches de seguridad posteriores al último BOM OSS 3.5; ver docs/audit/03. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.139.Final</netty.version>
        <tomcat.version>10.1.61</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>
    <modules>
        <module>api-gateway</module>
        <module>users-service</module>
        <module>prospects-service</module>
    </modules>
    <profiles>
        <profile>
            <id>coverage</id>
            <build><plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                    <executions>
                        <execution><id>coverage-agent</id><goals><goal>prepare-agent</goal></goals>
                            <configuration><append>false</append></configuration>
                        </execution>
                        <execution><id>coverage-report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
                        <execution><id>coverage-check</id><phase>verify</phase><goals><goal>check</goal></goals>
                            <configuration><rules><rule><element>BUNDLE</element><limits><limit>
                                <counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum>
                            </limit></limits></rule></rules></configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
