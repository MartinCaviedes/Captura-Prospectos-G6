# Plantilla de variables. Spring no carga este archivo automáticamente.
# Inyectar valores mediante el mecanismo del entorno de ejecución.
SPRING_PROFILES_ACTIVE=prod
JWT_ISSUER=captura-g6-users
JWT_AUDIENCE=captura-g6-api
JWT_PUBLIC_KEY=file:/run/secrets/jwt-public.pem
# Solo users-service necesita la clave privada.
JWT_PRIVATE_KEY=file:/run/secrets/jwt-private.pem
IDENTITY_JDBC_URL=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
PROSPECTS_JDBC_URL=
PROSPECTS_DB_USER=
PROSPECTS_DB_PASSWORD=
USERS_SERVICE_URL=http://users-service:8081
PROSPECTS_SERVICE_URL=http://prospects-service:8082
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s
SHUTDOWN_TIMEOUT=30s
# Solo para la ejecución explícita --bootstrap-admin; retirar después del uso.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_SITES=
LOGIN_RATE_LIMIT_REQUESTS=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_CLIENTS=10000
